PORT=3000
# Required to activate /admin. Choose a strong, unique value.
ADMIN_PASSWORD=
# Use a stable, randomly generated secret for sessions in production.
SESSION_SECRET=
# Set true behind HTTPS before deploying publicly.
COOKIE_SECURE=false
# Absolute path on persistent storage for production deployments.
DATA_DIR=./data
# Public HTTPS origin, used for canonical URLs and the sitemap.
PUBLIC_URL=
